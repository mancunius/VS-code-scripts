import os

def find_files_with_exact_text(directory, search_text, output_file):
    # List to store file paths containing the exact search text
    matching_files = []

    # Text-based file extensions to include
    valid_extensions = {'.tex', '.txt', '.html', '.csv', '.xml', '.md', '.gabc'}

    # Iterate through all files in the directory
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)

            # Skip files without valid extensions
            if not any(file.endswith(ext) for ext in valid_extensions):
                continue

            try:
                # Open the file and search for the exact text
                with open(file_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                    if search_text in content:
                        matching_files.append(file_path)
            except Exception as e:
                print(f"Error reading file {file_path}: {e}")

    # Write the matching files to the output file
    if matching_files:
        with open(output_file, 'w', encoding='utf-8') as f:
            for file in matching_files:
                f.write(file + '\n')
        print(f"Matching files saved to {output_file}")
    else:
        print("No files found containing the exact text.")

    return matching_files


