import csv
import re

def add_space_after_parenthesis(input_file, output_file):
    with open(input_file, mode='r', encoding='utf-8') as infile:
        reader = csv.DictReader(infile)
        fieldnames = reader.fieldnames
        
        rows = []
        
        for row in reader:
            content = row['Content']
            
            # Add space after the first ')' if it is not followed by a space
            content = re.sub(r'\)(?!\s)', ') ', content, 1)
            
            # Update the 'Content' column with the modified text
            row['Content'] = content
            rows.append(row)
    
    # Write the modified rows to the new output CSV file
    with open(output_file, mode='w', encoding='utf-8', newline='') as outfile:
        writer = csv.DictWriter(outfile, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)
    
    print(f"Modified CSV saved to {output_file}.")

