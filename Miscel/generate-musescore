import random
from music21 import stream, note, tempo, metadata, environment

# Define the 12-note scale
scale = ["C4", "D-4", "D4", "E-4", "E4", "F4", "F#4", "G#4", "A4", "B-4", "B4", "C5"]

# Define possible note values (durations)
note_values = {
    "minim": 2.0,  # Half note
    "crotchet": 1.0,  # Quarter note
    "quaver": 0.5,  # Eighth note
    "semiquaver": 0.25  # Sixteenth note
}

# Randomly select 16 notes (with repeats) and assign random durations to each
random_notes_with_values = [
    {"note": random.choice(scale), "value": random.choice(list(note_values.keys()))}
    for _ in range(16)
]

# Output the selected notes with their values
print("Randomly selected notes with values:")
for note_info in random_notes_with_values:
    print(f"{note_info['note']} ({note_info['value']})")

# Create a music21 stream
s = stream.Stream()

# Add a tempo marking
s.insert(0, tempo.MetronomeMark(number=120))

# Add a title and composer
s.insert(0, metadata.Metadata(title="Random Notes", composer="Generated by Python"))

# Add the randomly selected notes to the stream
for note_info in random_notes_with_values:
    n = note.Note(note_info["note"])
    n.duration.quarterLength = note_values[note_info["value"]]
    s.append(n)

# Save the stream as a MusicXML file
output_file = "random_notes.musicxml"
s.write("musicxml", fp=output_file)
print(f"MusicXML file saved as '{output_file}'.")

# Open the file in MuseScore
musescore_path = "/Applications/MuseScore 4.app/Contents/MacOS/mscore"
environment.set("musicxmlPath", musescore_path)
s.show("musicxml")