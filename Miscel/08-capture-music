import csv
import re

def process_csv(input_file, output_file):
    # Open the input CSV file
    with open(input_file, mode='r', encoding='utf-8') as infile:
        reader = csv.DictReader(infile)
        
        # Add the new 'Music' column to the fieldnames
        fieldnames = reader.fieldnames + ['Music']
        
        rows = []
        for row in reader:
            content = row['Content']
            
            # Use regex to find everything in parentheses followed by optional whitespace
            music = re.findall(r'\([^)]*\)\s?', content)
            
            # Join the found music parts into a single string
            music_text = "".join(music)

            # Replace ')' and '(' with '-' (optional, depending on needs)
            music_text = re.sub(r'\)\(','-',music_text)
            
            # Remove unwanted characters from the music text
            music_text = re.sub(r'(\))*(\()*\!*v*\/*~*\'*w*(\[.+?\])*','',music_text)

            # Remove "o", "<", and ">" from the music text
            music_text = music_text.replace('o', '').replace('<', '').replace('>', '').replace('@', '').replace('+', '').replace('Z', '').replace('z', '')

            # Remove certain digits (e.g., after periods or underscores)
            # music_text = re.sub(r'(?<=(\.|\_))(0|1)','',music_text)

            # Remove all digits 0 and 1
            music_text = re.sub(r'[012]', '', music_text)


            # Convert the music text to lowercase
            music_text = music_text.lower()

            # Add the captured music text to the new 'Music' column
            row['Music'] = music_text.strip()
            
            # Append the row to the rows list
            rows.append(row)
    
    # Write the updated rows to the output CSV file
    with open(output_file, mode='w', encoding='utf-8', newline='') as outfile:
        writer = csv.DictWriter(outfile, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    print(f"Processed {len(rows)} rows. Output saved to {output_file}.")

