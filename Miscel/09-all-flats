import csv
import re

# Function to replace "ix" with "*"
def replace_ix_with_star(text):
    return text.replace('ix', '*')

# Function to replace all 'i' with 'xi' after a '*' until the next space
def replace_i_with_xi(text):
    def replace_in_match(match):
        segment = match.group(0)
        return re.sub(r'i', r'xi', segment)  # Replace 'i' with 'xi' in the segment

    # Use regex to find segments starting with '*' and process them
    return re.sub(r'\*[^ ]*', replace_in_match, text)

# Function to remove all '*' from text
def remove_asterisks(text):
    return text.replace('*', '')

# Sequential processing function
def process_music_column_sequential(input_file, intermediate_file1, intermediate_file2, output_file):
    # Step 1: Replace "ix" with "*"
    with open(input_file, mode='r', encoding='utf-8') as infile, open(intermediate_file1, mode='w', encoding='utf-8', newline='') as intermediate1:
        reader = csv.DictReader(infile)
        fieldnames = reader.fieldnames
        rows = []

        for row in reader:
            music_text = row['Music']
            # Step 1: Replace "ix" with "*"
            music_text = replace_ix_with_star(music_text)
            row['Music'] = music_text.strip()
            rows.append(row)

        writer = csv.DictWriter(intermediate1, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    # Step 2: Add 'x' before 'i' following '*'
    with open(intermediate_file1, mode='r', encoding='utf-8') as intermediate1, open(intermediate_file2, mode='w', encoding='utf-8', newline='') as intermediate2:
        reader = csv.DictReader(intermediate1)
        rows = []

        for row in reader:
            music_text = row['Music']
            # Step 2: Add 'x' to 'i' after a '*'
            music_text = replace_i_with_xi(music_text)
            row['Music'] = music_text.strip()
            rows.append(row)

        writer = csv.DictWriter(intermediate2, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    # Step 3: Remove all '*'
    with open(intermediate_file2, mode='r', encoding='utf-8') as intermediate2, open(output_file, mode='w', encoding='utf-8', newline='') as outfile:
        reader = csv.DictReader(intermediate2)
        rows = []

        for row in reader:
            music_text = row['Music']
            # Step 3: Remove '*'
            music_text = remove_asterisks(music_text)
            row['Music'] = music_text.strip()
            rows.append(row)

        writer = csv.DictWriter(outfile, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    print(f"Processed rows saved to {output_file}")

