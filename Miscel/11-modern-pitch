input_csv = '/Users/martinbaker/Dropbox/04_Music/453_chant-data/csv-files/gabc_absolute.csv'  # Replace with your input file path
output_csv = '/Users/martinbaker/Dropbox/04_Music/453_chant-data/csv-files/modern_pitch.csv'  # Replace with your desired output file path

