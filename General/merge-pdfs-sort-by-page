from pathlib import Path
from PyPDF2 import PdfMerger
import re
from collections import defaultdict

# ---------- CONFIG ----------
PDF_DIR = Path("/Users/martinbaker/Documents/GitHub/ICEL-Graduale-Romanum/02-menke-print")

PAGE_RE = re.compile(r"-(\d{1,3})-icel\.pdf$")
CHANT_RE = re.compile(r"-(introit|gradual|alleluia|offertory|communion)-", re.IGNORECASE)

CHANT_ORDER = {
    "introit": 1,
    "gradual": 2,
    "alleluia": 3,
    "offertory": 4,
    "communion": 5
}

# ---------- PROMPT ----------
output_name = input("Enter output PDF filename (without .pdf): ").strip()
if not output_name:
    raise ValueError("Output filename cannot be empty.")

OUTPUT_PDF = PDF_DIR / f"{output_name}.pdf"

# ---------- COLLECT ----------
entries = []

for pdf in PDF_DIR.glob("*.pdf"):
    page_match = PAGE_RE.search(pdf.name)
    if not page_match:
        print(f"Skipping (no page number): {pdf.name}")
        continue

    chant_match = CHANT_RE.search(pdf.name)

    page = int(page_match.group(1))
    chant = chant_match.group(1).lower() if chant_match else "unknown"
    chant_rank = CHANT_ORDER.get(chant, 99)

    entries.append({
        "page": page,
        "chant": chant,
        "chant_rank": chant_rank,
        "pdf": pdf
    })

if not entries:
    raise RuntimeError("No valid PDFs found.")

# ---------- GROUP FOR DISAMBIGUATION ----------
grouped = defaultdict(list)
for e in entries:
    key = (e["page"], e["chant"])
    grouped[key].append(e)

final_entries = []

for (page, chant), group in grouped.items():
    if len(group) == 1:
        final_entries.append(group[0])
        continue

    # Conflict: same page + same chant
    print(f"\n⚠️  Multiple '{chant}' chants on page {page}:")
    for i, e in enumerate(group, start=1):
        print(f"  {i}: {e['pdf'].name}")

    order = input(
        "Enter preferred order as numbers separated by commas (e.g. 2,1): "
    ).strip()

    try:
        indices = [int(x) - 1 for x in order.split(",")]
        if sorted(indices) != list(range(len(group))):
            raise ValueError
    except ValueError:
        raise ValueError("Invalid ordering input.")

    for i in indices:
        e = group[i]
        # assign a temporary intra-group order
        e["suborder"] = indices.index(i)
        final_entries.append(e)

# ---------- SORT ----------
final_entries.sort(
    key=lambda e: (e["page"], e["chant_rank"], e.get("suborder", 0))
)

# ---------- MERGE ----------
merger = PdfMerger()

for e in final_entries:
    print(f"Adding page {e['page']} ({e['chant']}): {e['pdf'].name}")
    merger.append(str(e["pdf"]))

merger.write(str(OUTPUT_PDF))
merger.close()

print(f"\n✅ Merged PDF written to:\n{OUTPUT_PDF}")